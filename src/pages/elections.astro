---
import Base from "../layouts/Base.astro";
import ElectionPanel from "../components/ElectionPanel.svelte";
import ChiefRaceCard from "../components/ChiefRaceCard.astro";
import { existsSync, readFileSync, readdirSync } from "node:fs";
import { join } from "node:path";
import { buildYears } from "../lib/electionYears";
import {
  ELECTION_MILESTONES, STAGE_LABEL, chiefTitle, taipeiToday, timelineProgress,
  type CandidateEntry, type CountyCandidates, type NationalCandidates,
} from "../lib/candidateTypes";
import { candidateOverview, isCouncilReelect, partyTally, recordCounts, type PartyBar } from "../lib/candidateStats";
import { loadOfficials } from "../lib/data";
import { COUNTY_KEYS, countyByCode, countyPagePath } from "../lib/countyKeys";
import { countyRaceName } from "../lib/countyPage";

const meta = JSON.parse(readFileSync(join(process.cwd(), "public", "data", "map", "meta.json"), "utf8"));
// 年份切換器的資料來源，見 src/lib/electionYears.ts 開頭的說明——日後加 2018
// 等更早年份時，只改 buildYears()，這裡與 ElectionPanel.svelte 都不必動。
const years = buildYears(meta);
// 年份切換器：各年份是獨立頁面（2026 在本頁、2022 在 /elections/2022）。
const YEAR_HREF: Record<number, string> = { 2026: "/elections/", 2022: "/elections/2022/" };

// 2026 候選人靜態表：側欄是 client-side 元件，搜尋引擎與讀屏讀不到，這裡另出一份
// 伺服器端渲染的表。檔案不存在時略過整段，不擋建置。
let candidates2026: NationalCandidates | null = null;
try {
  candidates2026 = JSON.parse(readFileSync(join(process.cwd(), "public", "data", "candidates", "2026", "national.json"), "utf8"));
} catch (e) {
  console.warn(`candidates national.json 讀取失敗，/elections 候選人表略過：${(e as Error).message}`);
}

// 2026 縣市議員候選人：各縣市一個檔，依縣市長表的縣市順序（六都在前）排列。
const councilDir = join(process.cwd(), "public", "data", "candidates", "2026", "county");
const councils2026: CountyCandidates[] = (() => {
  if (!candidates2026 || !existsSync(councilDir)) return [];
  const byCode = new Map(readdirSync(councilDir).filter((f) => f.endsWith(".json"))
    .map((f) => JSON.parse(readFileSync(join(councilDir, f), "utf8")) as CountyCandidates)
    .map((c) => [c.countyCode, c]));
  return candidates2026.races.map((r) => byCode.get(r.countyCode)).filter((c): c is CountyCandidates => !!c);
})();
const councilTotal = councils2026.reduce((n, c) => n + c.districts.reduce((m, d) => m + d.candidates.length, 0), 0);
// 現任議員爭取連任：與「參選概況」數字磚共用同一條規則（src/lib/candidateStats.ts），
// 粗體人數與數字磚的人數才不會兜不攏。
const councilReelect = isCouncilReelect;

const fmtInt = (n: number): string => n.toLocaleString("en-US");

// ── 選務時程軸 ─────────────────────────────────────────────
// 以建置當天（臺灣日期）標出目前位置。頁面是靜態建置，「今天」就是最後一次建置的日期；
// 名單換版時會重新建置，時程軸跟著前進。
const today = taipeiToday();
const progress = timelineProgress(ELECTION_MILESTONES, today);
const shortDate = (iso: string) => `${Number(iso.slice(5, 7))}/${Number(iso.slice(8, 10))}`;
// 節點與「今天」標記攤成一串，畫成同一條線上的項目；今天正逢某節點時不另畫標記。
type TimelineItem = { kind: "node"; i: number } | { kind: "today" };
const timelineItems: TimelineItem[] = [
  ...(progress.todayAfter === -1 ? [{ kind: "today" as const }] : []),
  ...ELECTION_MILESTONES.flatMap((_, i): TimelineItem[] =>
    progress.todayAfter === i ? [{ kind: "node", i }, { kind: "today" }] : [{ kind: "node", i }]),
];

// ── 參選概況 ─────────────────────────────────────────────
const overview = candidates2026 ? candidateOverview(candidates2026, councils2026) : null;
const chiefBars = candidates2026 ? partyTally(candidates2026.races.flatMap((r) => r.candidates)) : [];
const councilBars = partyTally(councils2026.flatMap((co) => co.districts.flatMap((d) => d.candidates)));
const barGroups: { title: string; total: number; bars: PartyBar[] }[] = [
  ...(overview ? [{ title: "縣市長", total: overview.chiefCount, bars: chiefBars }] : []),
  ...(overview && councils2026.length > 0 ? [{ title: "縣市議員", total: overview.councilCount, bars: councilBars }] : []),
];
const barPct = (b: PartyBar, bars: PartyBar[]) => `${(b.count / Math.max(...bars.map((x) => x.count))) * 100}%`;

// ── 六都對決卡片 ／ 縣市長表「站上資料」欄 ──────────────────────
// 筆數取自站上檔案（以 slug 對應）；只列數字與連結，判決／爭議內容一律不上這頁。
const officialsBySlug = new Map((await loadOfficials()).map((o) => [o.slug, o]));
const countsOf = (c: CandidateEntry) => (c.slug ? recordCounts(officialsBySlug.get(c.slug)) : null);
const muniRaces = candidates2026 ? candidates2026.races.filter((r) => r.isMunicipality) : [];
// 各縣市的 2026 選舉頁（/elections/2026/<key>/）。對照表查無的縣市（理論上不會有）就不加連結。
const countyHref = (countyCode: string): string | undefined => {
  const k = countyByCode(countyCode);
  return k ? countyPagePath(k.key) : undefined;
};

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const homeUrl = Astro.site ? Astro.site.href : undefined;
const absUrl = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
// 分享縮圖：由 scraper/scripts/build-og-elections.ts 預先產生並 commit（建置環境沒有中文字型）。
const ogImage = Astro.site ? new URL("/og/elections-2026.png", Astro.site).href : undefined;
// 結構化資料：本頁主軸是 2026 候選人；2022 結果另見 /elections/2022（該頁有自己的 Dataset）。
const jsonLd = [
  // 2026 候選人：只在有資料時加入，排在 2022 結果之前（主軸是 2026）
  ...(candidates2026 ? [{
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "2026 年九合一選舉縣市長候選人",
    description: `2026 年九合一選舉縣市長候選人名單，資料來源為中央選舉委員會公布之名冊（${STAGE_LABEL[candidates2026.source.stage]}，製表 ${candidates2026.source.tableDate}），名單會隨選務進度更新。`,
    url: pageUrl,
    inLanguage: "zh-Hant",
    temporalCoverage: "2026",
    spatialCoverage: { "@type": "Place", name: "臺灣" },
    creator: { "@type": "Organization", name: "政治人物背景資料庫（本站）" },
    license: "資料彙整自中央選舉委員會（候選人名冊），非官方資料，請以原始出處為準。",
  }] : []),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "總覽", item: homeUrl },
      { "@type": "ListItem", position: 2, name: "九合一選舉", item: pageUrl },
    ],
  },
  // 22 個縣市選舉頁：讓搜尋引擎把本頁當成各縣市頁的目錄。
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "2026 九合一選舉各縣市候選人",
    numberOfItems: COUNTY_KEYS.length,
    itemListElement: COUNTY_KEYS.map((k, i) => ({
      "@type": "ListItem", position: i + 1, name: countyRaceName(k.name), url: absUrl(countyPagePath(k.key)),
    })),
  },
];
---

<Base title="九合一選舉地圖｜政治人物背景資料庫"
      description="2026 年九合一選舉：縣市長與縣市議員候選人名單，連結候選人經歷、判決與政治獻金；並以 2022 年結果作對照。"
      ogImage={ogImage}
      ogImageAlt="2026 九合一選舉候選人">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- 地圖滿版出血：跳出 .wrap 的 940px 上限、佔滿整個視窗寬度、緊接頁首，讓天下雜誌
       那種「地圖是主角、控制項浮在上面」的感覺成立——一進頁面不捲動就看到完整地圖。
       標題／倒數／年度標示改成浮在地圖左側的欄（見 ElectionPanel）。

       圖說（授權標示、領土說明）曾經是這裡一個獨立定位、疊在地圖左下角的區塊
       （用 JS 動態量報頭高度來避開它，量測時機抓不準）；後來又併入左欄報頭的
       欄位流，但左欄報頭內容本來就多（眉題／大標／版次／dateline／本期位置／
       導言／圖例），1568×766 這種較矮的視窗下最後一段仍會被切掉。現在圖說改放
       右欄——ElectionPanel.svelte 的 .sidebar-float 裡，接在資訊面板
       （.sidebar-panel）之下、釘在整欄底部；右欄在全國層通常只佔上半部，
       底下本來就空著。這裡不需要再另外的殼或腳本，細節見 ElectionPanel.svelte
       的樣式與注釋。 -->
  <div class="map-stage">
    <ElectionPanel client:load {years} initialYear={2026} yearHref={YEAR_HREF} />
  </div>

  <!-- 選務時程軸：伺服器端渲染，節點實心＝已過、空心＝未到；今天落在兩節點之間時，
       在線上另畫一個「今天」標記。窄螢幕改直排。 -->
  <section class="overview" aria-labelledby="timeline-title">
    <h2 id="timeline-title">選務時程</h2>
    <ol class="timeline">
      {timelineItems.map((it) => {
        if (it.kind === "today") {
          return (
            <li class="tl-today">
              <span class="tl-mark" aria-hidden="true"></span>
              <span class="tl-label">今天</span>
              <time class="tl-date" datetime={today}>{shortDate(today)}</time>
            </li>
          );
        }
        const m = ELECTION_MILESTONES[it.i];
        const st = progress.states[it.i];
        return (
          <li class={`tl-node ${st}`} aria-current={st === "current" ? "step" : undefined}>
            <span class="tl-dot" aria-hidden="true"></span>
            <span class="tl-label">{m.label}</span>
            <time class="tl-date" datetime={m.start}>{m.dateText}</time>
            <span class="sr-only">{st === "done" ? "（已過）" : st === "current" ? "（進行中）" : "（未到）"}</span>
          </li>
        );
      })}
    </ol>
    {candidates2026 && (
      <p class="overview-note">
        本站名單目前為：{STAGE_LABEL[candidates2026.source.stage]}（製表 {candidates2026.source.tableDate}）
      </p>
    )}
  </section>

  {overview && (
    <section class="overview" aria-labelledby="stats-title">
      <h2 id="stats-title">參選概況</h2>
      <dl class="tiles">
        <div class="tile"><dt>縣市長候選人</dt><dd class="tile-num">{fmtInt(overview.chiefCount)}</dd></div>
        {councils2026.length > 0 && (
          <div class="tile"><dt>縣市議員候選人</dt><dd class="tile-num">{fmtInt(overview.councilCount)}</dd></div>
        )}
        <div class="tile"><dt>現任縣市長爭取連任</dt><dd class="tile-num">{fmtInt(overview.chiefReelect)}</dd></div>
        {councils2026.length > 0 && (
          <div class="tile"><dt>現任議員爭取連任</dt><dd class="tile-num">{fmtInt(overview.councilReelect)}</dd></div>
        )}
        <div class="tile tile-wide">
          <dt>現任縣市長不得連任的縣市</dt>
          <dd class="tile-num">{fmtInt(overview.termLimited.length)}</dd>
          <dd class="tile-list">{overview.termLimited.join("、") || "無"}</dd>
        </div>
      </dl>

      <div class="bar-groups">
        {barGroups.map((g) => (
          <div class="bar-group">
            <h3>各黨提名人數・{g.title}</h3>
            <ul class="bars" aria-label={`${g.title}候選人各黨提名人數，共 ${fmtInt(g.total)} 人`}>
              {g.bars.map((b) => (
                <li class="bar-row">
                  <span class="bar-label">{b.label}</span>
                  <span class="bar-track" aria-hidden="true">
                    <span class="bar-fill" style={`width: ${barPct(b, g.bars)}; background: var(${b.cssVar});`}></span>
                  </span>
                  <span class="bar-count">{fmtInt(b.count)}<span class="sr-only"> 人</span></span>
                  {b.parties && (
                    <span class="bar-parties">{b.parties.map((p) => `${p.name} ${p.count}`).join("、")}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- 六都對決卡片：所有候選人同字級、同版型、同大小；排序依名冊（有號次時依號次），
       不依政黨或筆數。筆數只列數字，內容請見個人頁。卡片本身見 ChiefRaceCard.astro
       （與縣市選舉頁共用），標題連到該縣市的選舉頁。 -->
  {muniRaces.length > 0 && (
    <section class="overview" aria-labelledby="muni-title">
      <h2 id="muni-title">六都市長候選人</h2>
      <div class="muni-grid">
        {muniRaces.map((r) => <ChiefRaceCard race={r} officialsBySlug={officialsBySlug} href={countyHref(r.countyCode)} />)}
      </div>
      <p class="overview-note muni-foot">筆數為本站收錄之公開紀錄，非完整紀錄；內容與出處請見個人頁。</p>
    </section>
  )}

  {candidates2026 && (
    <section class="overview" aria-labelledby="cand-title">
      <h2 id="cand-title">2026 縣市長候選人</h2>
      <p class="overview-note">
        資料：<a href={candidates2026.source.url} rel="noopener">{STAGE_LABEL[candidates2026.source.stage]}</a>，
        製表 {candidates2026.source.tableDate}。六都在前，其餘依縣市代碼順序；同一縣市內依{candidates2026.races.every((r) => r.candidates.every((c) => c.number !== null)) ? "號次" : "中選會名冊順序"}排列。<strong>粗體</strong>為爭取連任的現任縣市長。
      </p>
      <div class="table-scroll">
        <table class="cand-table">
          <caption class="sr-only">2026 年各縣市首長選舉候選人</caption>
          <thead>
            <tr><th scope="col">選舉</th><th scope="col">候選人</th><th scope="col">站上資料</th></tr>
          </thead>
          <tbody>
            {candidates2026.races.map((r) => (
              <tr>
                <th scope="row">{countyHref(r.countyCode) ? <a href={countyHref(r.countyCode)}>{chiefTitle(r.countyName)}</a> : chiefTitle(r.countyName)}</th>
                <td>
                  {r.candidates.map((c, i) => (
                    <>
                      {i > 0 && "、"}
                      <span class={c.slug && c.slug === r.incumbent2022?.slug ? "cand reelect" : "cand"}><span class="nm">{c.slug ? <a href={`/officials/${c.slug}/`}>{c.name}</a> : c.name}</span>（{c.partyName === "無" ? "無黨籍" : c.partyName}）</span>
                    </>
                  ))}
                </td>
                <td class="recs">
                  {r.candidates.map((c) => {
                    const n = countsOf(c);
                    return n && (
                      <span class="rec"><a href={`/officials/${c.slug}/`}>{c.name}</a>：<span class="kv">判決 {n.judgments}</span>・<span class="kv">爭議 {n.controversies}</span>・<span class="kv">獻金 {n.donations}</span></span>
                    );
                  })}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {councils2026.length > 0 && (
    <section class="overview" aria-labelledby="council-title">
      <h2 id="council-title">2026 縣市議員候選人</h2>
      <p class="overview-note">
        22 縣市共 {fmtInt(councilTotal)} 人，依縣市展開查看各選區名單。<strong>粗體</strong>為爭取連任的現任議員；
        有連結者為本站已收錄檔案之人物。選區編號以中選會 2026 名冊為準，部分縣市已重劃。
      </p>
      {councils2026.map((co) => (
        <details class="council">
          <summary>
            <span class="council-name">{co.countyName}</span>
            <span class="council-count">
              {co.districts.length} 個選區・{co.districts.reduce((m, d) => m + d.candidates.length, 0)} 人
              {countyHref(co.countyCode) && <a class="council-more" href={countyHref(co.countyCode)}>完整名單 →</a>}
            </span>
          </summary>
          <dl class="council-list">
            {co.districts.map((d) => (
              <>
                <dt>{d.label}</dt>
                <dd>
                  {d.candidates.map((c, i) => (
                    <>
                      {i > 0 && "、"}
                      <span class={councilReelect(c) ? "cand reelect" : "cand"}><span class="nm">{c.slug ? <a href={`/officials/${c.slug}/`}>{c.name}</a> : c.name}</span>（{c.partyName === "無" ? "無黨籍" : c.partyName}）</span>
                    </>
                  ))}
                </dd>
              </>
            ))}
          </dl>
        </details>
      ))}
    </section>
  )}

  <p class="past-link">
    <a href="/elections/2022/">2022 年九合一選舉結果一覽（縣市長、議會席次、得票率）→</a>
  </p>

</Base>

<style>
  /* 標準的「跳出置中容器」技巧：50% 相對於父層（.wrap，已置中），50vw 相對於視窗，
     兩者相減剛好抵消置中造成的偏移，讓這個區塊左右都貼齊視窗邊緣。 */
  .map-stage {
    position: relative;
    width: 100vw;
    margin: 0 0 0 calc(50% - 50vw);
    /* 緊接頁首、填滿首屏：130px = 頁首 .site-head 實測高度 98px（padding-top 22px
       ＋padding-bottom 16px＋2px 邊框＋內容本身，實測 97.45px 取整）＋ Base.astro
       .main 的 padding-top 32px。這兩個數字都是量測值，不是變數，Base.astro 或
       站台頁首若改版就要重新量測。用 100dvh 而非 100vh，行動裝置網址列收合/展開時
       高度才不會跳動。 */
    height: calc(100dvh - 130px);
  }

  /* 窄螢幕：ElectionPanel 內的標題欄／資訊面板改回靜態排版、各自佔滿寬度，
     這裡的滿版地圖區塊也要跟著放棄固定滿版高度，否則會被硬撐出捲動軸內的
     捲動軸（雙重捲動）。斷點跟 ElectionPanel.svelte 的 900px 一致，必須同步改。
     圖說（現在是 ElectionPanel.svelte 報頭欄位流的一部分）會隨報頭本身的
     900px 規則一起退回一般文件流，這裡不需要再另外處理。 */
  @media (max-width: 900px) {
    .map-stage { height: auto; margin-top: 0; }
  }

  /* 視覺上隱藏但螢幕閱讀器讀得到：表格自己的 caption 已有 <h2> 當視覺標題，
     caption 只用來讓讀屏在直接跳到表格物件時仍報得出這是什麼表。 */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* 2026 候選人表與議員名單：報紙特輯的調性——髮絲線分隔、襯線體數字、不用卡片陰影或圓角。
     與地圖區塊隔開足夠留白，讓讀者一眼看出這是滿版地圖之後的另一段內容，
     不是地圖的附屬控制項。 */
  .overview { margin-top: 48px; }
  .overview h2 { font-size: var(--t-lg); margin: 0 0 8px; }
  .overview-note { color: var(--muted); font-size: 0.9375rem; line-height: 1.7; max-width: 72ch; margin: 0 0 20px; }

  /* 表格本身可能比 940px 的 .wrap 還寬（尤其中文縣市長全名＋政黨全名），窄螢幕
     讓這個殼自己橫向捲動，不讓表格擠壓整頁版面或把其他內容推出視窗。 */
  .table-scroll { overflow-x: auto; }

  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
