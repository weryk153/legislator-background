---
import FirstRunBadge from '../components/FirstRunBadge.svelte';
import Base from "../layouts/Base.astro";
import TitleCard from "../components/TitleCard.astro";
import ElectionFinder from "../components/ElectionFinder.svelte";
import ShareActions from "../components/ShareActions.svelte";
import { electionsDataset } from "../lib/clientDatasets";
import ElectionPanel from "../components/ElectionPanel.svelte";
import ElectionTimeline from "../components/ElectionTimeline.astro";
import SectionHead from "../components/SectionHead.astro";
import { existsSync, readFileSync, readdirSync } from "node:fs";
import { join } from "node:path";
import { buildYears } from "../lib/electionYears";
import {
  STAGE_LABEL, chiefTitle,
  type CandidateEntry, type CountyCandidates, type NationalCandidates,
} from "../lib/candidateTypes";
import { candidateOverview, isCouncilReelect, partyTally, partyLabel, recordCounts, type PartyBar } from "../lib/candidateStats";
import { loadOfficials } from "../lib/data";
import { COUNTY_KEYS, countyByCode, countyPagePath } from "../lib/countyKeys";
import { countyRaceName } from "../lib/countyPage";

const meta = JSON.parse(readFileSync(join(process.cwd(), "public", "data", "map", "meta.json"), "utf8"));
// 年份切換器的資料來源，見 src/lib/electionYears.ts 開頭的說明——日後加 2018
// 等更早年份時，只改 buildYears()，這裡與 ElectionPanel.svelte 都不必動。
const years = buildYears(meta);
// 年份切換器：各年份是獨立頁面（2026 在本頁、2022 在 /elections/2022）。
const YEAR_HREF: Record<number, string> = { 2026: "/elections/", 2022: "/elections/2022/" };

// 2026 候選人靜態表：側欄是 client-side 元件，搜尋引擎與讀屏讀不到，這裡另出一份
// 伺服器端渲染的表。檔案不存在時略過整段，不擋建置。
let candidates2026: NationalCandidates | null = null;
try {
  candidates2026 = JSON.parse(readFileSync(join(process.cwd(), "public", "data", "candidates", "2026", "national.json"), "utf8"));
} catch (e) {
  console.warn(`candidates national.json 讀取失敗，/elections 候選人表略過：${(e as Error).message}`);
}

// 2026 縣市議員候選人：各縣市一個檔，依縣市長表的縣市順序（六都在前）排列。
const councilDir = join(process.cwd(), "public", "data", "candidates", "2026", "county");
const councils2026: CountyCandidates[] = (() => {
  if (!candidates2026 || !existsSync(councilDir)) return [];
  const byCode = new Map(readdirSync(councilDir).filter((f) => f.endsWith(".json"))
    .map((f) => JSON.parse(readFileSync(join(councilDir, f), "utf8")) as CountyCandidates)
    .map((c) => [c.countyCode, c]));
  return candidates2026.races.map((r) => byCode.get(r.countyCode)).filter((c): c is CountyCandidates => !!c);
})();
const finderDataset = candidates2026 ? electionsDataset() : null;
const countyCounts = Object.fromEntries(COUNTY_KEYS.map(c => [c.code, {
  chief: finderDataset?.data.candidates.filter(r => r.countyCode === c.code && r.office === 'chief').length ?? 0,
  council: finderDataset?.data.candidates.filter(r => r.countyCode === c.code && r.office === 'council').length ?? 0,
}]));
const councilTotal = councils2026.reduce((n, c) => n + c.districts.reduce((m, d) => m + d.candidates.length, 0), 0);
// 現任議員爭取連任：與「參選概況」數字磚共用同一條規則（src/lib/candidateStats.ts），
// 粗體人數與數字磚的人數才不會兜不攏。
const councilReelect = isCouncilReelect;

const fmtInt = (n: number): string => n.toLocaleString("en-US");


// ── 參選概況 ─────────────────────────────────────────────
const overview = candidates2026 ? candidateOverview(candidates2026, councils2026) : null;
const chiefBars = candidates2026 ? partyTally(candidates2026.races.flatMap((r) => r.candidates)) : [];
const councilBars = partyTally(councils2026.flatMap((co) => co.districts.flatMap((d) => d.candidates)));
const barGroups: { title: string; total: number; bars: PartyBar[] }[] = [
  ...(overview ? [{ title: "縣市長", total: overview.chiefCount, bars: chiefBars }] : []),
  ...(overview && councils2026.length > 0 ? [{ title: "縣市議員", total: overview.councilCount, bars: councilBars }] : []),
];
const barPct = (b: PartyBar, bars: PartyBar[]) => `${(b.count / Math.max(...bars.map((x) => x.count))) * 100}%`;

// ── 縣市長表「站上資料」欄 ──────────────────────
// 筆數取自站上檔案（以 slug 對應）；只列數字與連結，判決／爭議內容一律不上這頁。
const officialsBySlug = new Map((await loadOfficials()).map((o) => [o.slug, o]));
const countsOf = (c: CandidateEntry) => (c.slug ? recordCounts(officialsBySlug.get(c.slug)) : null);
// 各縣市的 2026 選舉頁（/elections/2026/<key>/）。對照表查無的縣市（理論上不會有）就不加連結。
const countyHref = (countyCode: string): string | undefined => {
  const k = countyByCode(countyCode);
  return k ? countyPagePath(k.key) : undefined;
};

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const homeUrl = Astro.site ? Astro.site.href : undefined;
const absUrl = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
// 分享縮圖：由 scraper/scripts/build-og-elections.ts 預先產生並 commit（建置環境沒有中文字型）。
const ogImage = Astro.site ? new URL("/og/elections-2026.png", Astro.site).href : undefined;
// 結構化資料：本頁主軸是 2026 候選人；2022 結果另見 /elections/2022（該頁有自己的 Dataset）。
const jsonLd = [
  // 2026 候選人：只在有資料時加入，排在 2022 結果之前（主軸是 2026）
  ...(candidates2026 ? [{
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "2026 年九合一選舉縣市長候選人",
    description: `2026 年九合一選舉縣市長候選人名單，資料來源為中央選舉委員會公布之名冊（${STAGE_LABEL[candidates2026.source.stage]}，製表 ${candidates2026.source.tableDate}），名單會隨選務進度更新。`,
    url: pageUrl,
    inLanguage: "zh-Hant",
    temporalCoverage: "2026",
    spatialCoverage: { "@type": "Place", name: "臺灣" },
    creator: { "@type": "Organization", name: "政治人物背景資料庫（本站）" },
    citation: "資料彙整自中央選舉委員會（候選人名冊），非官方資料，請以原始出處為準。",
  }] : []),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "總覽", item: homeUrl },
      { "@type": "ListItem", position: 2, name: "九合一選舉", item: pageUrl },
    ],
  },
  // 22 個縣市選舉頁：讓搜尋引擎把本頁當成各縣市頁的目錄。
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "2026 九合一選舉各縣市候選人",
    numberOfItems: COUNTY_KEYS.length,
    itemListElement: COUNTY_KEYS.map((k, i) => ({
      "@type": "ListItem", position: i + 1, name: countyRaceName(k.name), url: absUrl(countyPagePath(k.key)),
    })),
  },
];
---

<Base title="2026 九合一選舉候選人查詢、政見比較｜政治人物背景資料庫"
      description="查詢 2026 九合一選舉各縣市長與議員候選人名單、學經歷及公開資料；勾選同縣市兩位首長候選人比較已收錄政見，附原始來源，並提供選區地圖與 2022 年選舉結果對照。"
      ogImage={ogImage}
      ogImageAlt="2026 九合一選舉候選人">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <header class="election-hero">
    <div class="hero-title"><TitleCard vertical="選舉特輯" lines={["九合一選舉", "找出你的候選人"]} heading="2026 九合一選舉候選人" variant="feature" fitContainer /></div>
    <div class="hero-meta"><p class="year">2026</p><p class="vote-date">投票日 11 月 28 日</p>
      {candidates2026 && <p class="data-stage"><a href={candidates2026.source.url}>{STAGE_LABEL[candidates2026.source.stage]}</a><br />製表 {candidates2026.source.tableDate}・名單隨選務進度更新</p>}
      <nav aria-label="選舉年份"><span aria-current="page">2026 候選人</span><a href="/elections/2022/">2022 選舉結果 →</a></nav>
    </div>
  </header>
  <ShareActions client:load title="2026 九合一選舉候選人｜政治人物背景資料庫" url={pageUrl ?? Astro.url.href} imageUrl="/og/elections-2026.png" imageName="2026-九合一選舉候選人.png" currentState />
  <nav class="section-nav" aria-label="選舉查詢"><a href="#finder-title">找候選人</a><a href="#election-map">地圖查詢</a><a href="#timeline-title">選務時程</a><a href="#stats-title">參選概況</a><a href="#full-roster">完整名冊</a></nav>
  {finderDataset && <ElectionFinder client:load {countyCounts} dataUrl={finderDataset.url} />}

  <details class="map-disclosure" id="election-map" open>
    <summary><span>地圖查詢</span><small>點選縣市，逐層查看行政區與候選人</small><span class="expand" aria-hidden="true">＋</span></summary>
    <div class="map-stage"><ElectionPanel client:visible {years} initialYear={2026} yearHref={YEAR_HREF} embedded /></div>
  </details>
  <script is:inline>
    if (window.matchMedia('(max-width: 760px)').matches) document.getElementById('election-map').open = false;
  </script>

  <!-- 選務時程軸：伺服器端渲染，節點實心＝已過、空心＝未到；今天落在兩節點之間時，
       在線上另畫一個「今天」標記。窄螢幕改直排。 -->
  <section class="overview" aria-labelledby="timeline-title">
    <SectionHead id="timeline-title" text="選務時程" />
    <ElectionTimeline />
    {candidates2026 && (
      <p class="overview-note">
        本站名單目前為：{STAGE_LABEL[candidates2026.source.stage]}（製表 {candidates2026.source.tableDate}）
      </p>
    )}
  </section>

  {overview && (
    <section class="overview" aria-labelledby="stats-title">
      <SectionHead id="stats-title" text="參選概況" />
      <dl class="tiles">
        <div class="tile"><dt>縣市長候選人</dt><dd class="tile-num">{fmtInt(overview.chiefCount)}</dd></div>
        {councils2026.length > 0 && (
          <div class="tile"><dt>縣市議員候選人</dt><dd class="tile-num">{fmtInt(overview.councilCount)}</dd></div>
        )}
        <div class="tile"><dt>現任縣市長爭取連任</dt><dd class="tile-num">{fmtInt(overview.chiefReelect)}</dd></div>
        {councils2026.length > 0 && (
          <div class="tile"><dt>現任議員爭取連任</dt><dd class="tile-num">{fmtInt(overview.councilReelect)}</dd></div>
        )}
        <div class="tile tile-wide">
          <dt>現任縣市長不得連任的縣市</dt>
          <dd class="tile-num">{fmtInt(overview.termLimited.length)}</dd>
          <dd class="tile-list">{overview.termLimited.join("、") || "無"}</dd>
        </div>
      </dl>

      <div class="bar-groups">
        {barGroups.map((g) => (
          <div class="bar-group">
            <h3>各黨提名人數・{g.title}</h3>
            <ul class="bars" aria-label={`${g.title}候選人各黨提名人數，共 ${fmtInt(g.total)} 人`}>
              {g.bars.map((b) => (
                <li class="bar-row">
                  <span class="bar-label">{b.label}</span>
                  <span class="bar-track" aria-hidden="true">
                    <span class="bar-fill" style={`width: ${barPct(b, g.bars)}; background: var(${b.cssVar});`}></span>
                  </span>
                  <span class="bar-count">{fmtInt(b.count)}<span class="sr-only"> 人</span></span>
                  {b.parties && (
                    <span class="bar-parties">{b.parties.map((p) => `${p.name} ${p.count}`).join("、")}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  <details class="full-roster" id="full-roster"><summary>完整名冊<span>縣市長與議員・依縣市展開</span></summary>
  {candidates2026 && (
    <section class="overview" aria-labelledby="cand-title">
      <SectionHead id="cand-title" text="2026 縣市長候選人" />
      <p class="overview-note">
        資料：<a href={candidates2026.source.url} rel="noopener">{STAGE_LABEL[candidates2026.source.stage]}</a>，
        製表 {candidates2026.source.tableDate}。六都在前，其餘依縣市代碼順序；同一縣市內依{candidates2026.races.every((r) => r.candidates.every((c) => c.number !== null)) ? "號次" : "中選會名冊順序"}排列。<strong>粗體</strong>為爭取連任的現任縣市長。
      </p>
      <div class="table-scroll">
        <table class="cand-table">
          <caption class="sr-only">2026 年各縣市首長選舉候選人</caption>
          <thead>
            <tr><th scope="col">選舉</th><th scope="col">候選人</th><th scope="col">站上資料</th></tr>
          </thead>
          <tbody>
            {candidates2026.races.map((r) => (
              <tr>
                <th scope="row">{countyHref(r.countyCode) ? <a href={countyHref(r.countyCode)}>{chiefTitle(r.countyName)}</a> : chiefTitle(r.countyName)}</th>
                <td>
                  {r.candidates.map((c, i) => (
                    <>
                      {i > 0 && "、"}
                      <span class={c.slug && c.slug === r.incumbent2022?.slug ? "cand reelect" : "cand"}><span class="nm">{c.slug ? <a href={`/officials/${c.slug}/`}>{c.name}</a> : c.name}<FirstRunBadge evidence={c.firstRun} name={c.name} /></span>（{partyLabel(c)}）</span>
                    </>
                  ))}
                </td>
                <td class="recs">
                  {r.candidates.map((c) => {
                    const n = countsOf(c);
                    return n && (
                      <span class="rec"><a href={`/officials/${c.slug}/`}>{c.name}</a>：<span class="kv">判決 {n.judgments}</span>・<span class="kv">爭議 {n.controversies}</span>・<span class="kv">獻金 {n.donations}</span></span>
                    );
                  })}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {councils2026.length > 0 && (
    <section class="overview" aria-labelledby="council-title">
      <SectionHead id="council-title" text="2026 縣市議員候選人" />
      <p class="overview-note">
        22 縣市共 {fmtInt(councilTotal)} 人，依縣市展開查看各選區名單。<strong>粗體</strong>為爭取連任的現任議員；
        有連結者為本站已收錄檔案之人物。選區編號以中選會 2026 名冊為準，部分縣市已重劃。
      </p>
      {councils2026.map((co) => (
        <details class="council">
          <summary>
            <span class="council-name">{co.countyName}</span>
            <span class="council-count">
              {co.districts.length} 個選區・{co.districts.reduce((m, d) => m + d.candidates.length, 0)} 人
              {countyHref(co.countyCode) && <a class="council-more" href={countyHref(co.countyCode)}>完整名單 →</a>}
            </span>
          </summary>
          <dl class="council-list">
            {co.districts.map((d) => (
              <>
                <dt>{d.label}</dt>
                <dd>
                  {d.candidates.map((c, i) => (
                    <>
                      {i > 0 && "、"}
                      <span class={councilReelect(c) ? "cand reelect" : "cand"}><span class="nm">{c.slug ? <a href={`/officials/${c.slug}/`}>{c.name}</a> : c.name}<FirstRunBadge evidence={c.firstRun} name={c.name} /></span>（{partyLabel(c)}）</span>
                    </>
                  ))}
                </dd>
              </>
            ))}
          </dl>
        </details>
      ))}
    </section>
  )}

  </details>

  <p class="past-link">
    <a href="/elections/2022/">2022 年九合一選舉結果一覽（縣市長、議會席次、得票率）→</a>
  </p>


</Base>

<style>
  .election-hero { display:grid;grid-template-columns:1.4fr 1fr;background:var(--block-bg);color:var(--block-fg);padding:28px;gap:30px; }
  .hero-title { container-type:inline-size;align-self:center;--feature-first-size:min(84px,calc((100cqw - 76px)/3.1)); }
  .hero-title :global(.tcard) { padding:0;background:transparent; }
  .hero-meta { border-left:1px solid color-mix(in srgb,var(--block-fg) 30%,transparent);padding-left:30px; }
  .year { font:900 66px/1 var(--serif);letter-spacing:-.05em;margin:0; }
  .vote-date { margin:8px 0 12px;font-size:15px; }
  .data-stage { font-size:12px;line-height:1.8;margin:0;opacity:.8; }
  .election-hero a { color:inherit; }
  .hero-meta nav { display:flex;flex-wrap:wrap;gap:16px;margin-top:14px;font-size:13px; }
  .hero-meta nav span { border-bottom:2px solid var(--accent);padding-bottom:4px; }
  .section-nav { display:flex;flex-wrap:wrap;gap:8px 24px;padding:14px 0;border-bottom:1px solid var(--line);font-size:13px; }
  .section-nav a { text-decoration:none; }
  .map-disclosure { margin:26px 0;border:1px solid var(--line-strong); }
  .map-disclosure > summary { display:flex;align-items:center;gap:18px;padding:16px 20px;cursor:pointer;list-style:none; }
  .map-disclosure > summary::-webkit-details-marker { display:none; }
  .map-disclosure > summary > span:first-child { font:900 24px var(--serif); }
  .map-disclosure small { color:var(--muted); }
  .expand { margin-left:auto; }
  .map-disclosure[open] .expand { transform:rotate(45deg); }
  .map-stage { border-top:1px solid var(--line);padding:18px; }
  .full-roster { margin-top:32px;border-top:3px solid var(--fg);border-bottom:1px solid var(--line); }
  .full-roster > summary { padding:20px 0;font:900 26px var(--serif);cursor:pointer; }
  .full-roster > summary span { font:400 13px var(--sans);color:var(--muted);margin-left:20px; }
  :global(#finder-title),:global(#timeline-title),:global(#stats-title),#election-map,#full-roster { scroll-margin-top:20px; }
  @media(max-width:760px) {
    .election-hero { grid-template-columns:1fr;padding:20px;gap:18px; }
    .hero-title { --feature-first-size:min(64px,calc((100cqw - 52px)/3.1));--feature-second-size:min(28px,calc((100cqw - 52px)/4.34)); }
    .hero-meta { border-left:0;border-top:1px solid color-mix(in srgb,var(--block-fg) 30%,transparent);padding:16px 0 0; }
    .year { font-size:40px;float:left;margin-right:18px; }
    .vote-date { margin:8px 0 18px; }.data-stage { clear:both; }
    .section-nav { gap:10px 18px; }
    .map-disclosure > summary { padding:14px;flex-wrap:wrap;gap:8px; }.map-disclosure small { order:3;width:100%; }
    .map-stage { padding:12px; }.full-roster > summary span { display:block;margin:8px 0 0; }
  }

  /* 2026 候選人表與議員名單：報紙特輯的調性——髮絲線分隔、襯線體數字、不用卡片陰影或圓角。
     與地圖區塊隔開足夠留白，讓讀者一眼看出這是滿版地圖之後的另一段內容，
     不是地圖的附屬控制項。 */
  .overview { margin-top: 30px; }
  .overview-note { color: var(--muted); font-size: 0.9375rem; line-height: 1.7; max-width: 72ch; margin: 0 0 20px; }

  /* 表格本身可能比 940px 的 .wrap 還寬（尤其中文縣市長全名＋政黨全名），窄螢幕
     讓這個殼自己橫向捲動，不讓表格擠壓整頁版面或把其他內容推出視窗。 */
  .table-scroll { overflow-x: auto; }

  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  caption { text-align: left; }
  th, td {
    text-align: left;
    padding: 9px 12px 9px 0;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  thead th {
    font-family: var(--serif);
    font-weight: 700;
    color: var(--muted);
    border-bottom: 1px solid var(--line-strong);
  }
  tbody tr:hover { background: var(--row-hover); }

  /* 2026 候選人表：一格裡列一整串候選人，必須能換行——上面 th, td 的 nowrap 是給
     2022 數字表用的，套到這裡會把整串名字撐成一行、整張表橫向溢出。換行只發生在
     候選人之間（.cand 內不斷開「姓名（政黨）」），表格也不需要 720px 的最小寬度。 */
  .cand-table { min-width: 0; }
  .cand-table td { white-space: normal; line-height: 1.8; vertical-align: top; }
  .cand-table thead th:first-child, .cand-table tbody th { width: 6.5em; vertical-align: top; }
  .cand { white-space: nowrap; }

