---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import DonorSearch from "../components/DonorSearch.svelte";
import { rankDonors, type Donor } from "../lib/donorFilter";
const desc = "查詢政治人物的政治獻金，或以公司名稱／統一編號反查營利事業捐贈給哪些候選人。資料來源：監察院政治獻金公開查閱平臺整批電子檔。";

// donors.astro 的主要內容（企業排行）原僅由 DonorSearch.svelte 在瀏覽器 onMount 後 fetch 取得，
// 搜尋引擎爬蟲看不到。此處在建置時直接讀同一份 public/data/donors.json，套用與
// DonorSearch 預設畫面相同的排序規則（rankDonors + minCount 2 + limit 50），
// 靜態輸出成純 HTML，供爬蟲索引；瀏覽器端 JS 成功載入資料後會移除此區塊（見 DonorSearch.svelte）。
type DonorsFile = { generatedAt: string; donors: Donor[] };
const donorsPath = join(process.cwd(), "public", "data", "donors.json");
// 檔案缺漏/損毀時退化為無靜態排行（頁面仍可由 client fetch 運作），不讓整個 build 失敗——
// 與 astro.config.mjs / Base.astro 讀 meta.json 的防護慣例一致。
let staticRanking: ReturnType<typeof rankDonors> = [];
try {
  const donorsFile: DonorsFile = JSON.parse(readFileSync(donorsPath, "utf8"));
  staticRanking = rankDonors(donorsFile.donors, { sort: "count" }, { minCount: 2, limit: 50 });
} catch (e) {
  console.warn(`donors.json 讀取失敗，/donors 靜態排行略過：${(e as Error).message}`);
}
const fmt = (n: number) => new Intl.NumberFormat("zh-Hant").format(n);
const officeName: Record<string, string> = { legislator: "立委", mayor_magistrate: "縣市首長", councilor: "議員" };
---
<Base title="政治獻金查詢｜政治人物背景" description={desc}>
  <header class="head">
    <h1>政治獻金查詢</h1>
    <p class="lede">輸入政治人物姓名，或營利事業名稱／統一編號，反查政治獻金流向。</p>
  </header>
  <DonorSearch client:load />
  <div id="static-ranking">
    <h2>捐給最多位現任政治人物的企業</h2>
    <ol class="static-list">
      {staticRanking.map(({ donor, view }) => (
        <li>
          <div class="static-donor-head">
            <span class="static-donor-name">{donor.name}</span>
            <span class="static-donor-meta">{view.count} 位現任・NT$ {fmt(view.total)}</span>
          </div>
          <ul class="static-recips">
            {view.recipients.map((r) => (
              <li>
                {r.slug
                  ? <a href={`/officials/${r.slug}`}>{r.name}</a>
                  : <span class="plain">{r.name}</span>}
                <span class="tag">{r.party}{r.officeType ? `・${officeName[r.officeType] ?? ""}` : ""}</span>
                <span class="amt">NT$ {fmt(r.amount)}</span>
                <span class="elec">{r.election}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
  <p class="note">
    政治獻金為依《政治獻金法》申報之合法公開紀錄。
    資料彙總自<a href="https://ardata.cy.gov.tw/data/downloads/election" target="_blank" rel="noopener">監察院政治獻金公開查閱平臺</a>整批電子檔（113年立法委員選舉、111年地方公職選舉及現任屆議員補選之首次申報），僅含營利事業捐贈；
    同統一編號之名稱變體已合併。個人捐贈不在本頁範圍。金額為程式彙總，請以平臺原始明細為準。
  </p>
  <style>
    .head { margin: 14px 0 22px; }
    .head h1 { font-size: var(--t-xl); margin: 0 0 6px; }
    .lede { margin: 0; color: var(--muted); }
    .note { font-size: var(--t-sm); color: var(--muted); margin-top: 28px; max-width: 72ch; }
    #static-ranking h2 { font-size: 1.0625rem; margin: 22px 0 8px; }
    .static-list { list-style: none; margin: 0; padding: 0; }
    .static-list > li { margin: 8px 0; padding: 10px 0; border-top: 1px solid var(--line); }
    .static-donor-head { display: flex; justify-content: space-between; gap: 12px; }
    .static-donor-name { font-weight: 700; }
    .static-donor-meta { color: var(--muted); font-size: 0.8125rem; flex: none; }
    .static-recips { list-style: none; margin: 6px 0 0; padding: 0; font-size: 0.875rem; }
    .static-recips li { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; padding: 4px 0; }
    .static-recips a { font-weight: 700; }
    .static-recips .plain { color: var(--muted); }
    .static-recips .tag { font-size: 0.75rem; color: var(--muted); }
    .static-recips .amt { margin-left: auto; }
    .static-recips .elec { flex: none; font-size: 0.75rem; color: var(--faint); }
  </style>
</Base>
