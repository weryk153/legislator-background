---
import Base from "../layouts/Base.astro";
import TitleCard from "../components/TitleCard.astro";
import SectionHead from "../components/SectionHead.astro";
import GraphExplorer from "../components/GraphExplorer.svelte";
import { loadGraph } from "../lib/loadGraph";
import { computeGlobalLayout } from "../lib/graphLayout";
import { OFFICE_LABEL, FAMILY_RELATIONS } from "../lib/graph";
import { entityRole } from "../lib/graphView";

const graph = loadGraph();
// 力導向排版在建置時算好，前端用固定座標（見 src/lib/graphLayout.ts）。
const positions = computeGlobalLayout(graph);
const familyCount = graph.edges.filter(edge => FAMILY_RELATIONS.has(edge.type)).length;
const title = "政治人物關係圖｜家族、派系、師徒與政治支持關係網";
const desc = `涵蓋 ${graph.nodes.length} 位政治人物與相關公眾人物、${graph.edges.length} 條已查證關係的互動關係圖，每條關係皆附公開資料出處。`;

// 圖本身完全由 client-side JS（Cytoscape）畫出，無 JS 或爬蟲看不到任何人名。
// 這裡另外輸出一份 SSG 純文字人物清單，作為圖的文字版本；只列人，不重複列 277 條
// 關係的 note／出處——互動明細與各自的檔案頁已提供逐筆出處。
// 第二行（括號內）：公職用職稱，外部人物優先用其描述而非通用類別——站上刻意保留了
// 幾組同名不同人（李佳芬、李傑），只印類別會讓兩人在清單裡完全一樣，看起來像重複資料。
// 圖上的標籤會截斷過長描述（版面所限），這裡有空間，顯示完整描述。
const peopleList = [...graph.nodes]
  .sort((a, b) => a.name.localeCompare(b.name, "zh-Hant"))
  .map((n) => ({
    key: n.key,
    name: n.name,
    slug: n.slug,
    role: n.kind === "official"
      ? OFFICE_LABEL[n.officeType!]
      : entityRole(n.description, n.subtype),
  }));
---

<Base title={title} description={desc}>
  <header class="graph-head">
    <div class="hero-title"><TitleCard vertical="公開資料" lines={["人物關係", "家族與政治網絡"]} heading="政治人物關係圖" fitContainer variant="feature" /></div>
    <div class="hero-copy"><p class="eyebrow">人物・關係・出處</p><p class="lede">循著一條關係，<br />查閱人物之間的公開紀錄。</p><p class="intro">搜尋姓名可聚焦直接關係；點選人物或連線，即可查看說明與出處。</p><a href="#graph-people">圖中人物文字清單 ↓</a></div>
  </header>
  <div class="graph-stats" aria-label="收錄關係摘要"><div><span>收錄人物</span><strong class="num">{graph.nodes.length}</strong><small>位</small></div><div><span>家族關係</span><strong class="num">{familyCount}</strong><small>條</small></div><div><span>政治關係</span><strong class="num">{graph.edges.length - familyCount}</strong><small>條</small></div></div>
  <a class="connection-entry" href="/graph/connect/"><span><strong>這兩個人，有什麼關係？</strong><small>選兩位人物，查看最短路徑與逐段出處。</small></span><b aria-hidden="true">↗</b></a>
  <GraphExplorer client:load data={graph} {positions} />
  <p class="data-note">關係資料整理自司法判決、媒體報導與公開資料，僅呈現已查證者，每條皆附出處。圖上位置僅供閱讀，不代表親疏或影響力；收錄關係不代表對當事人的評價。</p>

  <section class="sec people" id="graph-people">
    <SectionHead text="圖中人物清單" />
    <p class="note">關係圖的文字索引，依姓名排序。可點選的姓名連至本站個人檔案，其餘為相關公眾人物；同名者保留各自的身分說明。</p>
    <details class="people-directory"><summary><strong>展開全部人物</strong><span>{peopleList.length} 位・依姓名排序</span></summary>
    <ul class="people-list">
      {peopleList.map((p) => (
        <li>{p.slug ? <a class="rel-name" href={`/officials/${p.slug}/`}>{p.name} ↗</a> : <span class="rel-name plain">{p.name}</span>}<span class="rel-ext">{p.role}</span></li>
      ))}
    </ul>
    </details>
  </section>

  <style>
    .connection-entry { display:flex;justify-content:space-between;align-items:center;gap:20px;padding:20px 24px;margin-top:24px;border:1px solid var(--line-strong); }
    .connection-entry:hover { background:var(--row-hover); }
    .connection-entry strong { display:block;font:900 23px/1.4 var(--serif); }
    .connection-entry small { display:block;font-size:12px;color:var(--muted);margin-top:6px; }
    .connection-entry b { color:var(--accent);font-size:26px; }
    .graph-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 36px; margin: 14px 0 28px; }
    .hero-title { container-type: inline-size; min-width: 0; --feature-first-size: 84px; }
    .eyebrow { color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .16em; margin: 0 0 10px; }
    .lede { font: 700 20px/1.65 var(--serif); color: var(--fg); margin: 0; }
    .intro { font-size: 12px; color: var(--muted); margin: 10px 0; max-width: 34em; }
    .hero-copy > a { font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }
    .graph-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 16px 0; border-block: 1px solid var(--line); border-top-color: var(--fg); }
    .graph-stats > div { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; padding: 0 24px; border-right: 1px solid var(--line); }
    .graph-stats > div:first-child { padding-left: 0; }
    .graph-stats > div:last-child { border-right: 0; }
    .graph-stats span { flex: 1; color: var(--muted); font-size: 12px; }
    .graph-stats strong { font-size: 30px; line-height: 1.2; }
    .graph-stats small { font-size: 12px; color: var(--muted); }
    .data-note { margin: 16px 0; font-size: 12px; color: var(--muted); line-height: 1.8; max-width: 110ch; }
    .sec.people { margin: 32px 0 8px; scroll-margin-top: 24px; }
    .people :global(.sh) { margin-top: 0; }
    .note { font-size: 13px; color: var(--muted); line-height: 1.7; }
    .people-directory { border: 1px solid var(--line); }
    .people-directory summary { padding: 16px; cursor: pointer; background: var(--surface); }
    .people-directory summary strong { font-size: 14px; }
    .people-directory summary span { color: var(--muted); font-size: 12px; margin-left: 16px; }
    .people-list { list-style: none; margin: 0; padding: 12px 20px; columns: 3; column-gap: 28px; }
    .people-list li { padding: 10px 0; break-inside: avoid; border-bottom: 1px solid var(--line); }
    .rel-name { font-family: var(--serif); font-weight: 700; font-size: 17px; }
    a.rel-name:hover { color: var(--accent); }
    .rel-name.plain { color: var(--muted); }
    .rel-ext { display: block; margin-top: 3px; font-size: 12px; color: var(--faint); overflow-wrap: anywhere; }
    @media (max-width: 760px) {
      .graph-head { grid-template-columns: minmax(0, 1fr); gap: 12px; margin-bottom: 20px; }
      .hero-title { --feature-first-size: 64px; --feature-second-size: 28px; }
      .hero-copy .eyebrow, .hero-copy .lede { display: none; }
      .intro { margin-top: 0; }
      .graph-stats > div { padding: 0 12px; gap: 4px; }
      .graph-stats span { flex-basis: 100%; }
      .graph-stats strong { font-size: 26px; }
      .people-list { columns: 2; }
    }
    @media (max-width: 420px) { .people-list { columns: 1; } .people-directory summary span { display: block; margin: 6px 0 0 20px; } }
  </style>
</Base>
