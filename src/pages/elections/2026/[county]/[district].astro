---
import CandidateComparison from '../../../../components/CandidateComparison.svelte';
import CandidateReactions from '../../../../components/CandidateReactions.svelte';
import { comparisonCandidate } from '../../../../lib/candidateComparisonData';
import { loadCandidatePolicies } from '../../../../lib/candidatePolicies';
import Base from '../../../../layouts/Base.astro';
import ShareActions from '../../../../components/ShareActions.svelte';
import FirstRunBadge from '../../../../components/FirstRunBadge.svelte';
import { loadDistrictPages, type DistrictPageData } from '../../../../lib/districtPageData';
import { districtPageHeading, districtPageDescription, districtAreaSummary } from '../../../../lib/districtPage';
import { countyPagePath } from '../../../../lib/countyKeys';
import { candidateSourceLabel } from '../../../../lib/candidateTypes';
import { orderCandidates, partyLabel } from '../../../../lib/candidateStats';
import { loadOfficials } from '../../../../lib/data';
import { loadCandidateEducation, educationForDisplay } from '../../../../lib/candidateEducation';
import { districtCardId, shareCardPath, portraitCardPath } from '../../../../lib/shareCardData';
import { partyEmblem } from '../../../../lib/partyEmblems';
import { careerText } from '../../../../lib/careerCategory';

export async function getStaticPaths() {
  const officials = await loadOfficials();
  const bySlug = new Map(officials.map(o => [o.slug, o]));
  const education = loadCandidateEducation(officials);
  const policies = loadCandidatePolicies(officials);
  return loadDistrictPages().map(page => ({
    params: { county: page.county.key, district: `district-${page.district.no}` },
    props: {
      page,
      comparison: orderCandidates(page.district.candidates).map(c => comparisonCandidate(c,
        c.slug ? bySlug.get(c.slug) : undefined, c.slug ? education.get(c.slug) : undefined, c.slug ? policies.get(c.slug) : undefined)),
      candidates: orderCandidates(page.district.candidates).map(candidate => ({
        candidate,
        official: candidate.slug ? bySlug.get(candidate.slug) : undefined,
        education: candidate.slug ? education.get(candidate.slug) : undefined,
      })),
    },
  }));
}
const { page, candidates, comparison } = Astro.props;
const { county, council, district, area } = page as DistrictPageData;
const heading = districtPageHeading(county.name, district);
const title = `${heading}名單、學經歷｜政治人物背景資料庫`;
const description = districtPageDescription(county.name, district, area);
const imagePath = shareCardPath(districtCardId(county.key, district.no));
const abs = (path: string) => new URL(path, Astro.site ?? Astro.url.origin).href;
const pageUrl = abs(page.path);
const siblings = loadDistrictPages().filter(p => p.county.key === county.key);
const index = siblings.findIndex(p => p.district.no === district.no);
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: heading, description,
    url: pageUrl, inLanguage: 'zh-Hant', dateModified: council.source.tableDate,
    mainEntity: {
      '@type': 'ItemList', numberOfItems: candidates.length,
      itemListElement: candidates.map(({ candidate }, i) => ({
        '@type': 'ListItem', position: i + 1,
        item: { '@type': 'Person', name: candidate.name, ...(candidate.slug ? { url: abs(`/officials/${candidate.slug}/`) } : {}) },
      })),
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      ['總覽', '/'], ['九合一選舉', '/elections/'], [county.name, countyPagePath(county.key)], [district.label, page.path],
    ].map(([name, path], i) => ({ '@type': 'ListItem', position: i + 1, name, item: abs(path) })),
  },
];
---
<Base {title} {description} ogImage={abs(imagePath)} ogImageAlt={heading}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <nav class="crumbs" aria-label="頁面位置">
    <a href="/elections/">九合一選舉</a><span aria-hidden="true"> › </span>
    <a href={countyPagePath(county.key)}>{county.name}</a><span aria-hidden="true"> › </span>
    <span aria-current="page">{district.label}</span>
  </nav>
  <header class="district-head">
    <p class="eyebrow">2026 九合一選舉・議員選區</p>
    <h1>{county.name}<br />{district.label}<span class="subtitle">議員候選人</span></h1>
    <p class="intro">本區名冊共 <strong>{candidates.length}</strong> 人，整理學歷、經歷與公開資料來源。</p>
    <ShareActions client:load currentState title={heading} url={pageUrl} imageUrl={portraitCardPath(districtCardId(county.key, district.no))} imageName={`2026-${county.name}-${district.label}.png`} />
  </header>

  <section class="scope" aria-labelledby="scope-title">
    <h2 id="scope-title">選區範圍與名單狀態</h2>
    <p>{districtAreaSummary(area)}</p>
    {area.source
      ? <p class="note"><a href={`${area.source.pdfUrl}#page=${area.source.pages[0]}`} target="_blank" rel="noopener noreferrer">2026 中選會選區公告 ↗</a>・公告 {area.source.publishedOn}・本站核對 {area.source.reviewedOn}</p>
      : <p class="note">2026 範圍尚待本站核對，請以選委會公告為準。</p>}
    {area.note && area.towns.length > 0 && <p class="note">{area.note}</p>}
    <p class="note">名單版本：<a href={council.source.url} target="_blank" rel="noopener noreferrer">{candidateSourceLabel(council.source)} ↗</a>・更新 {council.source.tableDate}。{council.source.note}</p>
  </section>

  <section aria-labelledby="candidates-title">
    <CandidateComparison client:load candidates={comparison} canonical={pageUrl} {heading} />
    <p class="note">依{candidates.every(({ candidate }) => candidate.number !== null) ? '號次' : '中選會名冊順序'}排列。學歷為來源摘錄，非完整簡歷或最高學歷判定；2026 公報公布後，矛盾資料以該屆公報為準。</p>
    <ul class="candidates">
      {candidates.map(({ candidate: c, official, education }) => {
        const records = educationForDisplay(education);
        const record = records[0];
        const career = official?.careers.filter(item => !education?.excludedCareerIds.includes(item.id)
          && !/2026.*選舉登記參選/.test(item.title)).slice(0, 2) ?? [];
        const emblem = partyEmblem(partyLabel(c));
        return <li>
          <article>
            <header class="person-head">
              <h3>{c.number !== null && <small>{c.number} 號</small>}{c.slug ? <a href={`/officials/${c.slug}/`}>{c.name}</a> : c.name}</h3>
              <FirstRunBadge evidence={c.firstRun} name={c.name} />
              <p class="party">{emblem && <img src={emblem} alt="" width="18" height="18" loading="lazy" />}{partyLabel(c)}</p>
            </header>
            <div class="excerpt">
              <h4>學歷摘錄</h4>
              {record ? <>
                <ul>{record.items.slice(0, 2).map(item => <li>{item}</li>)}</ul>
                {record.note && <p class="note">{record.note}</p>}
                <p class="source"><a href={record.source.url} target="_blank" rel="noopener noreferrer">{record.source.title} ↗</a>{record.sourceYear && <>・{record.sourceYear} 年資料</>}</p>
              </> : <p class="note">本站尚未收錄可核對的學歷資料。</p>}
            </div>
            {career.length > 0 && <div class="excerpt">
              <h4>經歷摘錄</h4>
              <ul>{career.map(item => <li>{careerText(item.organization, item.title)}<a class="source" href={item.source.url} target="_blank" rel="noopener noreferrer"> 出處 ↗</a></li>)}</ul>
            </div>}
            {c.slug && <a class="profile-link" href={`/officials/${c.slug}/`}>查看完整人物資料 →</a>}
            {c.slug && <CandidateReactions client:visible candidate={c.slug} name={c.name} />}
          </article>
        </li>;
      })}
    </ul>
  </section>

  <nav class="district-nav" aria-label="其他議員選區">
    <h2>{county.name}其他選區</h2>
    <div class="neighbors">
      {index > 0 && <a href={siblings[index - 1].path}>← {siblings[index - 1].district.label}</a>}
      {index + 1 < siblings.length && <a href={siblings[index + 1].path}>{siblings[index + 1].district.label} →</a>}
    </div>
    <ul>{siblings.map(other => <li>{other.path === page.path
      ? <span aria-current="page">{other.district.label}</span>
      : <a href={other.path}>{other.district.label}</a>}</li>)}</ul>
    <a href={countyPagePath(county.key)}>← 返回{county.name}縣市長與議員名單</a>
  </nav>
</Base>

<style>
  .crumbs { font-size:13px;color:var(--muted);line-height:1.8; }
  a { text-underline-offset:3px; }
  .crumbs a { text-decoration:underline; }
  .district-head { margin:24px 0 28px; }
  .eyebrow { font-size:13px;color:var(--accent);font-weight:700; }
  h1 { font:900 clamp(30px,4vw,48px)/1.4 var(--serif);margin:10px 0 16px;overflow-wrap:anywhere; }
  .subtitle { display:block;font:600 18px var(--sans);margin-top:12px; }
  .intro { color:var(--muted);font-size:15px;max-width:48em; }
  .scope { padding:18px 20px;border:1px solid var(--line);margin-bottom:36px;overflow-wrap:anywhere; }
  h2 { font:900 23px var(--serif);margin:0 0 14px; }
  .scope h2 { font-size:19px; }
  .scope p { margin:8px 0; }
  .note { color:var(--muted);font-size:13px;line-height:1.8; }
  .note a,.source a { text-decoration:underline; }
  .candidates { list-style:none;padding:0;margin:20px 0 40px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 32px; }
  .candidates > li { border-top:1px solid var(--line);padding:22px 0;min-width:0; }
  article { overflow-wrap:anywhere; }
  h3 { font:900 28px/1.5 var(--serif);margin:0; }
  h3 a { text-decoration:underline;text-decoration-thickness:1px; }
  h3 small { font:400 13px var(--sans);margin-right:8px; }
  .party { display:flex;gap:6px;align-items:center;font-size:13px;margin:7px 0 18px; }
  .party img { flex:none;object-fit:contain; }
  h4 { font-size:13px;margin:14px 0 7px; }
  .excerpt ul { padding-left:1.25em;margin:0;font-size:14px;line-height:1.8; }
  .source { font-size:12px;color:var(--muted);line-height:1.7;text-decoration:underline; }
  .profile-link { display:inline-flex;align-items:center;min-height:44px;margin-top:8px;font-size:13px;text-decoration:underline; }
  .district-nav { border-top:3px solid var(--fg);padding-top:20px;margin-bottom:32px;font-size:14px; }
  .district-nav a { text-decoration:underline; }
  .district-nav ul { display:flex;flex-wrap:wrap;gap:8px 18px;list-style:none;padding:0;margin:20px 0; }
  .district-nav [aria-current] { font-weight:700; }
  .neighbors { display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px; }
  @media(max-width:600px) { .candidates { grid-template-columns:1fr; }.scope { padding:14px; }h3 { font-size:25px; } }
</style>
