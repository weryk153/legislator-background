---
import Base from "../layouts/Base.astro";
import OfficialTable from "../components/OfficialTable.svelte";
import TitleCard from "../components/TitleCard.astro";
import SectionHead from "../components/SectionHead.astro";
import ElectionTimeline from "../components/ElectionTimeline.astro";
import { loadOfficials } from "../lib/data";
import { toListRow } from "../lib/transform";

// 參選人檔案由選舉頁進入，不列入總覽（總覽收錄對象為現任公職）。
const officials = (await loadOfficials()).filter((o) => o.officeType !== "candidate");
const rows = officials.map(toListRow);
const desc = `查詢台灣 ${officials.length} 位立法委員、縣市首長與縣市議員的經歷、司法判決、爭議報導與財產申報，每筆皆附公開資料出處。`;
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "政治人物背景資料庫",
    description: desc,
    url: siteUrl || undefined,
    inLanguage: "zh-Hant",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "政治人物背景資料庫",
    description: "以可查證、附出處的方式公開台灣政治人物的背景資料。",
    url: siteUrl || undefined,
    logo: siteUrl ? `${siteUrl}/og.png` : undefined,
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "政治人物背景資料庫 資料集",
    description: desc,
    url: siteUrl || undefined,
    creator: { "@type": "Organization", name: "政治人物背景資料庫（本站）" },
    license: "資料彙整自公開來源（立法院開放資料、中央選舉委員會、司法院裁判書系統、監察院公職人員財產申報、維基百科），非官方資料，請以原始出處為準。",
  },
];
---
<Base title="政治人物背景資料庫" description={desc}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="lead">
    <TitleCard as="h2" vertical="第壱話" lines={["九合一", "候選人背景總整理"]} href="/elections/" />
    <div class="lead-text">
      <p>2026 縣市長與縣市議員參選人的經歷、判決、爭議與政治獻金，逐縣市整理。</p>
      <a class="go" href="/elections/">看選舉頁 →</a>
    </div>
  </section>

  <SectionHead text="選務時程" />
  <ElectionTimeline />

  <SectionHead text="名冊" />
  <p class="term-note">收錄對象：第11屆立法委員（2024年當選）、2022年當選之縣市首長與縣市議員（任期至2026）。任內已解職者保留並標註「已解職」。</p>
  <OfficialTable client:load rows={rows} />
  <style>
    .lead { display: flex; gap: 28px; align-items: flex-end; margin: 4px 0 0; }
    .lead-text p { margin: 0; max-width: 30em; color: var(--muted); }
    .go { display: inline-block; margin-top: 10px; font-weight: 700; border-bottom: 2px solid var(--fg); }
    .term-note { margin: 0 0 14px; font-size: var(--t-sm); color: var(--faint); max-width: 64ch; line-height: 1.6; }
    @media (max-width: 640px) { .lead { flex-direction: column; align-items: flex-start; gap: 14px; } }
  </style>
</Base>
