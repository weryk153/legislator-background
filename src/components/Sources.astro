---
import type { Source } from "../lib/types";
import { sourceLinks } from '../lib/sourceLinks';
const { sources } = Astro.props as { sources: Source[] };
const shown = sourceLinks(sources ?? []);
---
{shown.length > 1 ? <details class="sources">
  <summary>出處 <span class="count">{shown.length} 個來源</span></summary>
  <ul>{shown.map(s => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
</details> : <div class="sources">
  <span class="lbl">出處</span>
  {shown.map((s, i) => (
    <a href={s.url} target="_blank" rel="noopener">{s.label}{i < shown.length - 1 ? "、" : ""}</a>
  ))}
</div>}

<style>
  .sources { font-size: var(--t-sm); color: var(--muted); margin-top: 8px; }
  summary { cursor: pointer; min-height: 32px; align-content: center; font-size: var(--t-xs); }
  .count { color: var(--faint); margin-left: 6px; }
  ul { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 4px 0 0; padding: 0; list-style: none; }
  li { overflow-wrap: anywhere; }
  .lbl {
    font-size: var(--t-xs); letter-spacing: 0.1em; color: var(--faint);
    margin-right: 6px;
  }
  .sources a { text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--line-strong); }
  .sources a:hover { color: var(--accent); text-decoration-color: var(--accent); }
</style>
