---
import { PARTY_VAR, type MapArea } from '../lib/mapTypes';
import SectionHead from './SectionHead.astro';
import { normalizeParty } from '../lib/partyNames';

interface Props { areas: MapArea[] }
const { areas } = Astro.props;
const winners = new Map<string, { name: string; counties: MapArea[] }>();
const seats = new Map<string, { name: string; count: number }>();
for (const area of areas) {
  const winner = area.race?.candidates.find(candidate => candidate.elected);
  if (winner) {
    const group = winners.get(winner.partyCode) ?? { name: normalizeParty(winner.partyName), counties: [] };
    group.counties.push(area);
    winners.set(winner.partyCode, group);
  }
  for (const party of area.seats) {
    const entry = seats.get(party.partyCode) ?? { name: normalizeParty(party.partyName), count: 0 };
    entry.count += party.seats;
    seats.set(party.partyCode, entry);
  }
}
const chiefs = [...winners].sort((a, b) => b[1].counties.length - a[1].counties.length);
const parties = [...seats].sort((a, b) => b[1].count - a[1].count);
const total = parties.reduce((sum, [, party]) => sum + party.count, 0);
const color = (code: string) => `var(${PARTY_VAR[code] ?? '--party-other'})`;
---
<section class="results" aria-labelledby="distribution-title">
  <SectionHead id="distribution-title" text="縣市長當選分布" />
  <dl class="chiefs">
    {chiefs.map(([code, { name, counties }]) => (
      <div class="column">
        <dt><i style={`--ink:${color(code)}`} aria-hidden="true"></i>{name}</dt>
        <dd class="figure">{counties.length}<small>縣市</small></dd>
        <dd class="places">{counties.map(county => <a href={`#county-${county.code}`}>{county.name}</a>)}</dd>
      </div>
    ))}
  </dl>
  <section class="seats" aria-label="全國議會席次分布">
    <h3>議會席次 <small>共 {total.toLocaleString('zh-TW')} 席</small></h3>
    <div class="breakdown">
      <div class="bar" aria-hidden="true">{parties.map(([code, party]) => <span style={`flex:${party.count};background:${color(code)}`}></span>)}</div>
      <ul>{parties.slice(0, 4).map(([code, party]) => <li><i style={`--ink:${color(code)}`}></i>{party.name} <b>{party.count}</b></li>)}</ul>
      {parties.length > 4 && <details><summary>其餘 {parties.length - 4} 黨席次</summary><ul>{parties.slice(4).map(([code, party]) => <li><i style={`--ink:${color(code)}`}></i>{party.name} <b>{party.count}</b></li>)}</ul></details>}
    </div>
  </section>
</section>
<style>
  .results { margin-block:30px; }
  .chiefs { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); margin:24px 0; }
  .column { padding-inline:clamp(12px,2vw,30px); border-inline-start:1px solid var(--line); }
  .column:first-child { padding-inline-start:0; border:0; }
  dt, li { display:flex; align-items:center; gap:7px; }
  dt { font-weight:700; }
  i { display:inline-block; width:8px; height:8px; background:var(--ink); flex:none; }
  dd { margin:0; }
  .figure { font:900 clamp(38px,4.5vw,68px)/1.15 var(--serif); letter-spacing:-.05em; margin:4px 0 8px; }
  .figure small,h3 small { font:400 13px var(--sans); letter-spacing:normal; margin-left:6px; color:var(--muted); }
  .places { color:var(--muted); font:400 14px/1.9 var(--serif); }
  .places a { display:inline-block; margin-inline-end:0.8em; white-space:nowrap; text-underline-offset:3px; }
  .places a:hover,summary:hover { color:var(--accent); }
  .seats { display:grid; grid-template-columns:max-content 1fr; align-items:baseline; gap:24px; border-block:1px solid var(--line); padding:16px 0; }
  h3 { margin:0; font:900 20px var(--serif); }
  .bar { display:flex; height:8px; }
  ul { display:flex; flex-wrap:wrap; gap:8px 24px; margin:9px 0 0; padding:0; }
  li,summary { font-size:13px; }
  summary { color:var(--muted); cursor:pointer; width:fit-content; margin-top:8px; }
  @media(max-width:760px) {
    .chiefs { grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px 0; }
    .column:nth-child(odd) { padding-inline-start:0; border:0; }
    .seats { grid-template-columns:1fr; gap:12px; }
  }
</style>
